{
  "name": "mothership",
  "private": true,
  "version": "1.15.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generateChangelog.js && vite build && node scripts/createSpaFallback.js",
    "generate:changelog": "node scripts/generateChangelog.js",
    "generate:duty-calendar": "node scripts/generateDutyCalendar.js",
    "preview": "vite preview",
    "dev:react": "vite --mode react",
    "typecheck": "tsc --noEmit",
    "build:react": "pnpm typecheck && vite build --mode react && node scripts/createSpaFallback.js dist-react",
    "preview:react": "vite preview --mode react"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.12.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^7.0.2",
    "vite": "^7.3.1",
    "vite-imagetools": "^9.0.3",
    "vite-plugin-image-optimizer": "^2.0.3"
  },
  "packageManager": "pnpm@10.30.3"
